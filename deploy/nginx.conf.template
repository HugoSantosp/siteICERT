# ============================================================
# siteICERT — Nginx (template para o Render)
#
# A entrypoint oficial da imagem nginx processa este arquivo no
# boot (envsubst) substituindo SOMENTE as env vars definidas:
#   ${PORT}        → porta injetada pelo Render (sempre definida)
#   ${BACKEND_URL} → URL pública do backend Spring Boot no Render
#                    (ex.: https://sge-backend.onrender.com)
#
# Resultado em produção:
#   https://icertag.com.br/                    → site público
#   https://icertag.com.br/SGE-Administracao/  → painel administrativo
#   https://icertag.com.br/SGE-MeuMinisterio/  → app Meu Ministério
#   https://icertag.com.br/api|auth|uploads/*  → proxy p/ o backend
# ============================================================

server {
    listen ${PORT};
    server_name _;

    # Redirects RELATIVOS (sem host/porta): sem isso, o nginx responde
    # "Location: https://icertag.com.br:10000/..." usando a porta interna
    # do Render (PORT=10000), que não é exposta publicamente → timeout.
    absolute_redirect off;
    # Mantém o host original do cliente nos redirects (ex.: icertag.com.br)
    server_name_in_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve o DNS do backend em runtime (IPs do Render podem mudar entre deploys)
    resolver 8.8.8.8 valid=30s ipv6=off;

    # URL do backend — definida como env var no painel do Render
    set $backend_url "${BACKEND_URL}";

    # ---- Proxy HTTPS para o backend ----
    # proxy_ssl_server_name ON: envia o SNI (nome do servidor) no handshake TLS.
    # Sem isso o Cloudflare/CDN do Render rejeita a conexão (SSL alert 40),
    # pois o IP atende vários domínios e não sabe qual certificado usar.
    proxy_ssl_server_name on;
    # Timeouts um pouco mais folgados (backend Free pode demorar pra acordar)
    proxy_connect_timeout 30s;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;

    # ---- Site público (raiz) ----
    location = / {
        try_files /index.html =404;
    }

    # ---- Acesso sem a barra final (o base href exige a barra) ----
    location = /SGE-Administracao { return 301 /SGE-Administracao/; }
    location = /SGE-MeuMinisterio { return 301 /SGE-MeuMinisterio/; }

    # ---- App ADMIN (painel administrativo) ----
    location /SGE-Administracao/ {
        alias /usr/share/nginx/html/SGE-Administracao/;
        try_files $uri $uri/ /SGE-Administracao/index.html;
    }

    # ---- App MEU MINISTÉRIO ----
    location /SGE-MeuMinisterio/ {
        alias /usr/share/nginx/html/SGE-MeuMinisterio/;
        try_files $uri $uri/ /SGE-MeuMinisterio/index.html;
    }

    # ---- Backend: API ----
    location ^~ /api/ {
        proxy_pass $backend_url$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Backend: autenticação ----
    location ^~ /auth/ {
        proxy_pass $backend_url$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Backend: fotos/uploads (o Spring Boot serve os arquivos) ----
    location ^~ /uploads/ {
        proxy_pass $backend_url$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Backend: Swagger (opcional) ----
    location ^~ /swagger-ui {
        proxy_pass $backend_url$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /v3/api-docs/ {
        proxy_pass $backend_url$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Assets com hash no nome (cache longo) ----
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---- Gzip ----
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;
}
